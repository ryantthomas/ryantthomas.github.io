---
import '../styles/global.css';
import site from '../data/site.yaml';

interface Props {
  title: string;
  description: string;
  /** Renders the "← Back to all work" link. */
  back?: boolean;
}

const { title, description, back = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <div class="wrap">
    <nav>
      <a class="brand" href="/">{site.name}</a>
      <a href="/#work">Work</a>
      <a href="/#experience">Experience</a>
      <a href="/resume/">Résumé</a>
      <a href={site.contact.github}>GitHub</a>
      <a href={`mailto:${site.contact.email}`}>Email</a>
    </nav>

    {back && <a class="back" href="/">← Back to all work</a>}

    <slot />

    <footer>
      <div class="contact-row">
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a href={site.contact.github}>GitHub</a>
        <a href={site.contact.linkedin}>LinkedIn</a>
        <a href="/resume/">Full résumé</a>
      </div>
      <p style="margin:0">{site.locationNote}</p>
    </footer>
  </div>
</body>
</html>
