---
import '../../styles/global.css';
import site from '../../data/site.yaml';

const canonical = new URL('/resume/', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{site.name} — Résumé</title>
  <meta name="description" content={`Résumé for ${site.name}, ${site.role}.`} />
  <link rel="canonical" href={canonical} />
</head>
<body class="resume">
  <div class="wrap-resume">

    <a class="back no-print" href="/">← Back to portfolio</a>

    <header class="resume-head">
      <h1>{site.name}</h1>
      <p class="resume-contact">
        {site.location} &nbsp;|&nbsp;
        {site.contact.phone} &nbsp;|&nbsp;
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> &nbsp;|&nbsp;
        <a href={site.contact.github}>{site.contact.githubLabel}</a> &nbsp;|&nbsp;
        <a href={site.contact.linkedin}>{site.contact.linkedinLabel}</a>
      </p>
    </header>

    <section>
      <h2 class="rule">Skills</h2>
      {site.skills.map((s: any) => (
        <p class="skill-line"><strong>{s.label}:</strong> {s.value}</p>
      ))}
    </section>

    <section>
      <h2 class="rule">Experience</h2>
      {site.experience.map((job: any) => (
        <>
          <div class="resume-role">
            <span><strong>{job.role}</strong>, {job.org}, {job.place}</span>
            <span class="when">{job.dates}</span>
          </div>
          <ul class="desc">{job.bullets.map((b: string) => <li>{b}</li>)}</ul>
        </>
      ))}
    </section>

    <section>
      <h2 class="rule">Education</h2>
      <div class="resume-role">
        <span><strong>{site.education.degree}</strong>, {site.education.school}, {site.education.place}</span>
        <span class="when">{site.education.date}</span>
      </div>
    </section>

    <p class="no-print print-hint">
      Print this page (Ctrl/Cmd&nbsp;+&nbsp;P) to save a clean one-page PDF.
    </p>

  </div>
</body>
</html>
