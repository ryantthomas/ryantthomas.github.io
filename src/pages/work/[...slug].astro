---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={`${d.title} — Ryan Thomas`} description={d.description} back>
  <h1>{d.title}</h1>
  <p class="lede">{d.summary}</p>
  <p class="stack">{d.tech}</p>

  {d.private && (
    <div class="note">
      <p>
        <strong>Private repository.</strong> The architecture and results below
        are the whole of it — happy to walk through the code directly.
      </p>
    </div>
  )}

  {d.diagram && (
    <figure>
      <img src={d.diagram} alt={d.diagramAlt} />
      {d.diagramCaption && <figcaption set:html={d.diagramCaption} />}
    </figure>
  )}

  <Content />

  {(d.repo || d.extraLinks.length > 0) && (
    <>
      <h2>Links</h2>
      <p>
        {d.repo && <><a href={d.repo}>{d.repo.replace('https://', '')}</a><br /></>}
        {d.extraLinks.map((l: any) => <><a href={l.url}>{l.label}</a><br /></>)}
      </p>
    </>
  )}
</Base>
